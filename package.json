{
  "name": "hephaestus",
  "version": "0.1.0",
  "description": "write ai agents once in markdown. forge and sync them for claude, copilot, and codex.",
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude",
    "copilot",
    "codex",
    "provisioning",
    "cli"
  ],
  "license": "MIT",
  "author": {
    "name": "odysseusdev",
    "url": "https://github.com/odysseusdev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/odysseusdev/hephaestus.git"
  },
  "bugs": {
    "url": "https://github.com/odysseusdev/hephaestus/issues"
  },
  "homepage": "https://github.com/odysseusdev/hephaestus#readme",
  "type": "module",
  "bin": {
    "hephaestus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
